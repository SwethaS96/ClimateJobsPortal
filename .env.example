# Copy to .env and fill in real values. .env is gitignored — never commit credentials.

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Optional cap on how many notifications one digest email includes.
# Leave blank (or "unlimited") for no limit at all — the digest will
# include every pending notification (email_sent=0), however many there
# are. Set a positive integer only if you want a cap reintroduced;
# notifications beyond an active cap stay email_sent=0 and go out in the
# next run, they are never discarded.
EMAIL_MAX_NOTIFICATIONS=
